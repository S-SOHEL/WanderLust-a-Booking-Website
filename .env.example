# ====================================================
# WanderLust - Environment Configuration Template
# Duplicate this file as .env and fill in your values
# ====================================================

# Port for the web server (defaults to 8080 if omitted)
PORT=8080

# Session secret key for express-session cookie encryption
SECRET=your_super_secret_session_key_here

# Local MongoDB connection (used for local development)
MONGO_URL=mongodb://127.0.0.1:27017/wanderlust

# MongoDB Atlas connection string (used in production or when USE_ATLAS=true)
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wanderlust?retryWrites=true&w=majority

# Set to true to force connection to Atlas instead of local MongoDB
USE_ATLAS=false

# Cloudinary Configuration for Image Uploads
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# Mapbox Public Access Token for interactive maps and geocoding
MAP_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXB1YmxpYy10b2tlbiJ9.xxxx

# Optional: Seed / Initial Administrator Account Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@wanderlust.com
ADMIN_PASSWORD=your_secure_admin_password
