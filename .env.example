# ====================================================
# WanderLust - Environment Configuration Template
# Duplicate this file as .env and fill in your values
# ====================================================

# Runtime environment (development | production)
NODE_ENV=development

# Port for the web server (defaults to 8080 if omitted; Render injects PORT automatically)
PORT=8080

# Session secret key for express-session cookie encryption (REQUIRED in production)
SECRET=your_super_secret_session_key_here

# Local MongoDB connection (default fallback for local development)
MONGO_URL=mongodb://127.0.0.1:27017/wanderlust

# Separate Cloud MongoDB Development Database (recommended for local dev on Atlas cluster)
# Must point to a dedicated dev database (e.g. wanderlust_dev), NEVER the production database.
# DEV_ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/wanderlust_dev?retryWrites=true&w=majority
USE_CLOUD_DEV=false

# Production MongoDB Atlas connection string (USED ONLY WHEN NODE_ENV=production)
ATLASDB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/test?retryWrites=true&w=majority

# Cloudinary Configuration for Image Uploads
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret
# Optional: defaults to wanderlust_PROD in production and wanderlust_DEV in development
# CLOUDINARY_FOLDER=wanderlust_PROD

# Mapbox Public Access Token (pk.*) for interactive maps and geocoding
MAP_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJ5b3VyLXB1YmxpYy10b2tlbiJ9.xxxx

# Optional: Seed / Primary Administrator Account Credentials
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@wanderlust.com
ADMIN_PASSWORD=your_secure_admin_password

# Optional: Dedicated 32-byte AES-256 Encryption Key for Admin 2FA TOTP secrets at rest (defaults to SECRET if omitted)
# ADMIN_2FA_ENCRYPTION_KEY=your_32_character_encryption_key_here

# Optional: Cloudflare Turnstile Free Anti-Bot Protection for Admin Login
# TURNSTILE_SITE_KEY=your_cloudflare_turnstile_site_key
# TURNSTILE_SECRET_KEY=your_cloudflare_turnstile_secret_key

# ====================================================
# Secure Evidence Vault (Phase 10.7 & 10.8)
# ====================================================
# Dedicated 256-bit AES-256-GCM Encryption Key for evidence documents (deeds, tax receipts, agreements)
# MANDATORY when NODE_ENV=production (minimum 32 characters; fallback to SECRET is disabled in production)
# EVIDENCE_VAULT_KEY=your_64_character_hex_or_32_character_encryption_key_here

# Persistent storage directory mount path for encrypted evidence documents
# MANDATORY when NODE_ENV=production (e.g. /var/data/wanderlust_vault on Render Persistent Disk)
# Defaults to ./vault_storage in local development/test
# EVIDENCE_VAULT_PATH=/var/data/wanderlust_vault
