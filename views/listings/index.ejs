<% layout("/layouts/boilerplate") %>

<%
  function cleanTitle(str) {
    if (!str) return "WanderLust Stay";
    return str.replace(/\s+[0-9]{5,}\b/g, "").replace(/_[0-9]{5,}\b/g, "").trim();
  }
%>

<!-- Floating Airbnb-Style Search Section -->
<div class="search-wrapper my-2">
  <form class="airbnb-search" method="GET" action="/listings/search" id="airbnbSearchForm">
    <!-- Where -->
    <div class="search-segment">
      <label for="search-where">Where</label>
      <input 
        id="search-where"
        type="text" 
        name="location" 
        value="<%= typeof searchLocation !== 'undefined' ? searchLocation : '' %>" 
        placeholder="Search destinations, cities, or stays"
        autocomplete="off">
    </div>

    <div class="search-divider d-none d-md-block"></div>

    <!-- When: Check-in -->
    <div class="search-segment d-none d-md-flex">
      <label for="search-checkin">Check in</label>
      <input 
        id="search-checkin" 
        type="date" 
        name="checkIn" 
        value="<%= typeof checkIn !== 'undefined' ? checkIn : '' %>"
        style="font-size: 13px;">
    </div>

    <div class="search-divider d-none d-md-block"></div>

    <!-- When: Checkout -->
    <div class="search-segment d-none d-md-flex">
      <label for="search-checkout">Check out</label>
      <input 
        id="search-checkout" 
        type="date" 
        name="checkOut" 
        value="<%= typeof checkOut !== 'undefined' ? checkOut : '' %>"
        style="font-size: 13px;">
    </div>

    <div class="search-divider d-none d-sm-block"></div>

    <!-- Who: Guests -->
    <div class="search-segment d-none d-sm-flex" style="max-width: 160px;">
      <label for="search-who">Who</label>
      <input 
        id="search-who" 
        type="number" 
        min="1" 
        max="20" 
        name="guests" 
        value="<%= typeof searchGuests !== 'undefined' && searchGuests ? searchGuests : (typeof guests !== 'undefined' && guests ? guests : '') %>" 
        placeholder="Add guests">
    </div>

    <!-- Search Button -->
    <button class="btn-search ms-auto" type="submit" title="Search WanderLust Stays">
      <i class="fa-solid fa-magnifying-glass"></i>
    </button>
  </form>
</div>

<!-- Category Filters Bar -->
<div class="filters-container d-flex align-items-center mb-3">
  <div id="filters" class="d-flex align-items-center">
    <% 
      const categories = [
        { name: "All", icon: "fa-earth-americas" },
        { name: "Trending", icon: "fa-fire" },
        { name: "Rooms", icon: "fa-bed" },
        { name: "Iconic Cities", icon: "fa-city" },
        { name: "Mountains", icon: "fa-mountain-sun" },
        { name: "Castles", icon: "fa-fort-awesome" },
        { name: "Amazing Pools", icon: "fa-water-ladder" },
        { name: "Camping", icon: "fa-campground" },
        { name: "Farms", icon: "fa-wheat-awn" },
        { name: "Arctic", icon: "fa-snowflake" },
        { name: "Domes", icon: "fa-igloo" },
        { name: "Boats", icon: "fa-ship" },
      ];
      const activeCat = typeof selectedCategory !== 'undefined' ? selectedCategory : 'All';
    %>

    <% for (let cat of categories) { %>
      <a href="/listings?category=<%= cat.name %><%= typeof currentSort !== 'undefined' ? '&sort=' + currentSort : '' %>" class="filter <%= activeCat === cat.name ? 'active' : '' %>">
        <div><i class="fa-solid <%= cat.icon %>"></i></div>
        <p><%= cat.name %></p>
      </a>
    <% } %>
  </div>

  <!-- Tax Switch Toggle -->
  <div class="tax-toggle ms-3 d-none d-lg-flex align-items-center">
    <div class="form-check form-switch form-check-reverse m-0">
      <input class="form-check-input cursor-pointer" type="checkbox" role="switch" id="taxSwitch">
      <label class="form-check-label fw-semibold small cursor-pointer" for="taxSwitch">Display total after taxes</label>
    </div>
  </div>
</div>

<!-- Secondary Toolbar: Property Type & Sorting -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4 p-2 bg-white rounded-3 border small">
  <div class="d-flex flex-wrap align-items-center gap-2">
    <!-- Property Type Filter Dropdown -->
    <div class="dropdown">
      <button class="btn btn-sm btn-white border dropdown-toggle bg-white rounded-pill px-3 fw-medium" type="button" data-bs-toggle="dropdown">
        <i class="fa-solid fa-house-chimney me-1 text-secondary"></i> Property Type: <strong><%= typeof propertyType !== 'undefined' && propertyType !== 'All' ? propertyType : 'All' %></strong>
      </button>
      <ul class="dropdown-menu shadow-sm rounded-3">
        <li><a class="dropdown-item" href="/listings?<%= typeof selectedCategory !== 'undefined' ? 'category=' + selectedCategory : '' %>">All Types</a></li>
        <li><a class="dropdown-item" href="/listings?propertyType=Apartment<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Apartments</a></li>
        <li><a class="dropdown-item" href="/listings?propertyType=Villa<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Villas</a></li>
        <li><a class="dropdown-item" href="/listings?propertyType=Cabin<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Cabins</a></li>
        <li><a class="dropdown-item" href="/listings?propertyType=Cottage<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Cottages</a></li>
        <li><a class="dropdown-item" href="/listings?propertyType=Haveli<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Havelis & Heritage</a></li>
        <li><a class="dropdown-item" href="/listings?propertyType=Studio<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Studios</a></li>
      </ul>
    </div>

    <!-- Sorting Dropdown -->
    <div class="dropdown">
      <button class="btn btn-sm btn-white border dropdown-toggle bg-white rounded-pill px-3 fw-medium" type="button" data-bs-toggle="dropdown">
        <i class="fa-solid fa-arrow-down-short-wide me-1 text-secondary"></i> Sort: 
        <strong>
          <% if (typeof currentSort !== 'undefined' && currentSort === 'price_asc') { %> Price: Low to High
          <% } else if (typeof currentSort !== 'undefined' && currentSort === 'price_desc') { %> Price: High to Low
          <% } else { %> Recommended
          <% } %>
        </strong>
      </button>
      <ul class="dropdown-menu shadow-sm rounded-3">
        <li><a class="dropdown-item" href="/listings?sort=newest<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Recommended (Newest)</a></li>
        <li><a class="dropdown-item" href="/listings?sort=price_asc<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Price: Low to High</a></li>
        <li><a class="dropdown-item" href="/listings?sort=price_desc<%= typeof selectedCategory !== 'undefined' ? '&category=' + selectedCategory : '' %>">Price: High to Low</a></li>
      </ul>
    </div>

    <!-- Active Filter Indicators -->
    <% if ((typeof selectedCategory !== 'undefined' && selectedCategory !== 'All') || (typeof searchLocation !== 'undefined' && searchLocation)) { %>
      <span class="text-secondary ms-1">
        Found <%= allListings.length %> <%= allListings.length === 1 ? 'stay' : 'stays' %>
      </span>
      <a href="/listings" class="btn btn-sm btn-outline-danger py-0 px-2 rounded-pill ms-1">
        <i class="fa-solid fa-xmark me-1"></i>Clear
      </a>
    <% } %>
  </div>

  <span class="text-muted small">
    Showing <%= allListings.length %> verified accommodations
  </span>
</div>

<!-- Listings Grid or Empty State -->
<% if (allListings.length === 0) { %>
  <div class="text-center py-5 my-4 bg-white rounded-4 border p-4 shadow-sm">
    <div class="rounded-circle bg-light d-inline-flex align-items-center justify-content-center p-4 mb-3 text-secondary" style="width: 80px; height: 80px;">
      <i class="fa-solid fa-magnifying-glass fs-2"></i>
    </div>
    <h4 class="fw-bold text-dark">No exact matches found</h4>
    <p class="text-secondary small mx-auto" style="max-width: 440px;">
      Try adjusting your search criteria, clearing selected categories, or exploring other popular destinations.
    </p>
    <a href="/listings" class="btn btn-primary-custom mt-2 px-4 py-2 rounded-pill shadow-sm">
      Browse All Stays
    </a>
  </div>
<% } else { %>
  <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
    <% for (let listing of allListings) { %>
      <%
        let ratingText = "New";
        let hasReviews = listing.reviews && listing.reviews.length > 0;
        if (hasReviews) {
          const sum = listing.reviews.reduce((acc, r) => acc + (r.rating || 5), 0);
          ratingText = (sum / listing.reviews.length).toFixed(1);
        }
      %>
      <div class="col">
        <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark d-block h-100">
          <div class="card listing-card h-100">
            <!-- Property Image with Badges -->
            <div class="card-img-wrapper">
              <img 
                src="<%= listing.image && listing.image.url ? listing.image.url : (listing.images && listing.images.length > 0 ? listing.images[0].url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60') %>" 
                class="listing-img" 
                alt="<%= cleanTitle(listing.title) %>"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60';">
              
              <!-- Badges -->
              <div class="position-absolute top-0 start-0 m-2 d-flex gap-1 flex-wrap">
                <% if (listing.featured) { %>
                  <span class="badge-featured">
                    <i class="fa-solid fa-star me-1"></i>Featured
                  </span>
                <% } %>
                <% if (listing.propertyType) { %>
                  <span class="badge-pill-blur">
                    <%= listing.propertyType %>
                  </span>
                <% } %>
              </div>

              <% if (listing.category) { %>
                <span class="badge-pill-blur position-absolute top-0 end-0 m-2">
                  <%= listing.category %>
                </span>
              <% } %>
            </div>

            <!-- Card Content Body -->
            <div class="card-body px-1 pt-3 pb-1">
              <div class="d-flex justify-content-between align-items-baseline mb-1">
                <h6 class="card-title-text mb-0 text-truncate pe-2">
                  <%= cleanTitle(listing.title) %>
                </h6>
                <div class="d-flex align-items-center text-nowrap small fw-semibold">
                  <i class="fa-solid fa-star text-warning me-1" style="font-size: 11px;"></i>
                  <span><%= ratingText %></span>
                </div>
              </div>

              <p class="card-location-text text-truncate mb-1">
                <i class="fa-solid fa-location-dot me-1 text-danger" style="font-size: 11px;"></i><%= listing.location %>, <%= listing.country %>
              </p>

              <p class="card-specs-text mb-2">
                <%= listing.maxGuests || 2 %> guests &middot; <%= listing.bedrooms || 1 %> bed &middot; <%= listing.bathrooms || 1 %> bath
              </p>

              <div class="pt-2 border-top d-flex justify-content-between align-items-baseline">
                <div>
                  <span class="price-night-text">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : "0" %></span>
                  <span class="price-unit-text"> / night</span>
                  <span class="tax-info tax-badge-info" style="display: none;">
                    &middot; &#8377;<%= listing.price ? Math.round(listing.price * 1.18).toLocaleString("en-IN") : "" %> incl. tax
                  </span>
                </div>
              </div>
            </div>
          </div>
        </a>
      </div>
    <% } %>
  </div>
<% } %>

<!-- Tax Switch Toggle & Search Date Validation Script -->
<script>
  // Tax switch toggle
  const taxSwitch = document.getElementById("taxSwitch");
  if (taxSwitch) {
    taxSwitch.addEventListener("change", () => {
      const taxInfoElements = document.getElementsByClassName("tax-info");
      for (let elem of taxInfoElements) {
        elem.style.display = taxSwitch.checked ? "inline" : "none";
      }
    });
  }

  // Date picker validation
  const inDate = document.getElementById("search-checkin");
  const outDate = document.getElementById("search-checkout");
  if (inDate && outDate) {
    const today = new Date().toISOString().split("T")[0];
    inDate.min = today;
    inDate.addEventListener("change", () => {
      outDate.min = inDate.value;
      if (outDate.value && outDate.value < inDate.value) {
        outDate.value = inDate.value;
      }
    });
  }
</script>
