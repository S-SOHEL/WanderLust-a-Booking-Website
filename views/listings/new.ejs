<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            


            <h3>Create  a New Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">


                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input class="form-control" name="listing[title]" placeholder="Add a catchy title" type="text"
                    required />
                    <div class="valid-feedback">Tittle looks good !!</div>
                </div>
                


                <div class="mb-3 "><label for="description" class="form-label">Description</label>
                    <input class="form-control" name="listing[description]" placeholder="Enter description" type="text"
                         />
                </div>




                <!-- <div class="mb-3"><label class="form-label" for="image">Image Link</label>
                    <input class="form-control" name="listing[image]" placeholder="Enter image URL/Link" type="text"
                 />
                </div> -->

                <div class="mb-3"><label class="form-label" for="image"> Upload Listing Image </label>
                    <input class="form-control" name="listing[image]" placeholder="Enter image URL/Link" type="file"
                 />
                </div>

                <div class="row">


                    <div class="mb-3 col-md-4"><label class="form-label" for="price">Price (INR)</label>
                        <input class="form-control" name="listing[price]" placeholder="1200" ype="number" 
                        required/>
                        <div class="invalid-feedback">Price should be valid</div>

                    </div>


                    <div class="mb-3 col-md-8"><label class="form-label" for="country">Country</label>
                        <input name="listing[country]" class="form-control" placeholder="india" type="text" 
                          required/>
                          <div class="invalid-feedback">Country should be valid</div>
                    </div>

                </div>


                <div class="mb-3"><label class="form-label" for="location">Location</label>
                    <input class="form-control" name="listing[location]" placeholder="Pune Maharastra" type="text"
                     required/>
                     <div class="invalid-feedback">Location should be valid</div>
                </div>





                <button class="btn btn-dark add-btn mt-3" type="submit">Add Listing</button>
            </form>

        </div>
    </div>