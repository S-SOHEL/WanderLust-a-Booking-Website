<% layout("/layouts/boilerplate") %>

<% const currentTab = 'newListing'; %>
<%- include("./adminNav.ejs", { currentTab }) %>

<div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-5">
  <div class="mb-4 pb-2 border-bottom">
    <h3 class="fw-bold mb-1">Add New Property to Inventory</h3>
    <p class="text-muted small">Fill in the details below. Coordinates will be automatically geocoded using Mapbox unless manually entered.</p>
  </div>

  <form action="/admin/listings" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
    <!-- Title & Property Type -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-8">
        <label for="title" class="form-label fw-semibold">Property Title <span class="text-danger">*</span></label>
        <input type="text" name="listing[title]" id="title" class="form-control" placeholder="E.g., Luxury Sea-Facing Penthouse" required>
        <div class="invalid-feedback">Title is required.</div>
      </div>
      <div class="col-12 col-md-4">
        <label for="propertyType" class="form-label fw-semibold">Property Type</label>
        <select name="listing[propertyType]" id="propertyType" class="form-select">
          <option value="Apartment" selected>Apartment</option>
          <option value="Villa">Villa</option>
          <option value="Cabin">Cabin</option>
          <option value="Cottage">Cottage</option>
          <option value="Studio">Studio</option>
          <option value="Haveli">Haveli</option>
          <option value="House">House</option>
          <option value="Resort">Resort</option>
          <option value="Hotel">Hotel</option>
          <option value="Other">Other</option>
        </select>
      </div>
    </div>

    <!-- Description -->
    <div class="mb-3">
      <label for="description" class="form-label fw-semibold">Description <span class="text-danger">*</span></label>
      <textarea name="listing[description]" id="description" rows="4" class="form-control" placeholder="Describe the space, atmosphere, views, and special features..." required></textarea>
      <div class="invalid-feedback">Description is required.</div>
    </div>

    <!-- Images: Upload File OR Image URL -->
    <div class="row g-3 mb-3 p-3 bg-light rounded-3 border">
      <div class="col-12 col-md-6">
        <label for="imageFile" class="form-label fw-semibold">Upload Property Image File</label>
        <input type="file" name="listing[image]" id="imageFile" class="form-control">
        <small class="text-muted">Cloudinary upload (.jpg, .png, .jpeg)</small>
      </div>
      <div class="col-12 col-md-6">
        <label for="imageUrl" class="form-label fw-semibold">Or Provide High-Res Image URL</label>
        <input type="url" name="listing[imageUrl]" id="imageUrl" class="form-control" placeholder="https://images.unsplash.com/...">
        <small class="text-muted">Used if no file is uploaded above</small>
      </div>
    </div>

    <!-- Category, Price, and Capacity -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-4">
        <label for="category" class="form-label fw-semibold">Category</label>
        <select name="listing[category]" id="category" class="form-select">
          <option value="Trending" selected>Trending</option>
          <option value="Rooms">Rooms</option>
          <option value="Iconic Cities">Iconic Cities</option>
          <option value="Mountains">Mountains</option>
          <option value="Castles">Castles</option>
          <option value="Amazing Pools">Amazing Pools</option>
          <option value="Camping">Camping</option>
          <option value="Farms">Farms</option>
          <option value="Arctic">Arctic</option>
          <option value="Domes">Domes</option>
          <option value="Boats">Boats</option>
        </select>
      </div>

      <div class="col-12 col-md-4">
        <label for="price" class="form-label fw-semibold">Price per Night (INR) <span class="text-danger">*</span></label>
        <div class="input-group">
          <span class="input-group-text">&#8377;</span>
          <input type="number" name="listing[price]" id="price" min="0" class="form-control" placeholder="5000" required>
        </div>
        <div class="invalid-feedback">Price must be valid.</div>
      </div>

      <div class="col-12 col-md-4">
        <label for="maxGuests" class="form-label fw-semibold">Guest Capacity</label>
        <input type="number" name="listing[maxGuests]" id="maxGuests" min="1" max="30" value="2" class="form-control">
      </div>
    </div>

    <!-- Rooms Breakdown -->
    <div class="row g-3 mb-3">
      <div class="col-4">
        <label for="bedrooms" class="form-label fw-semibold small">Bedrooms</label>
        <input type="number" name="listing[bedrooms]" id="bedrooms" min="0" value="1" class="form-control">
      </div>
      <div class="col-4">
        <label for="beds" class="form-label fw-semibold small">Beds</label>
        <input type="number" name="listing[beds]" id="beds" min="1" value="1" class="form-control">
      </div>
      <div class="col-4">
        <label for="bathrooms" class="form-label fw-semibold small">Bathrooms</label>
        <input type="number" name="listing[bathrooms]" id="bathrooms" min="1" value="1" class="form-control">
      </div>
    </div>

    <!-- Location, Country, and Coordinates -->
    <div class="row g-3 mb-3">
      <div class="col-12 col-md-6">
        <label for="location" class="form-label fw-semibold">Location / City <span class="text-danger">*</span></label>
        <input type="text" name="listing[location]" id="location" class="form-control" placeholder="E.g., Candolim, Goa" required>
        <div class="invalid-feedback">Location is required.</div>
      </div>
      <div class="col-12 col-md-6">
        <label for="country" class="form-label fw-semibold">Country <span class="text-danger">*</span></label>
        <input type="text" name="listing[country]" id="country" class="form-control" value="India" required>
        <div class="invalid-feedback">Country is required.</div>
      </div>
    </div>

    <!-- Optional Manual Coordinates -->
    <div class="row g-3 mb-3 p-3 bg-light rounded-3 border">
      <div class="col-12">
        <span class="fw-semibold small d-block">Mapbox Coordinates (Optional Override)</span>
        <small class="text-muted">Leave empty to automatically geocode the location via Mapbox API.</small>
      </div>
      <div class="col-6">
        <label for="latitude" class="form-label small text-muted">Latitude</label>
        <input type="number" step="any" name="listing[latitude]" id="latitude" class="form-control form-control-sm" placeholder="E.g., 15.5186">
      </div>
      <div class="col-6">
        <label for="longitude" class="form-label small text-muted">Longitude</label>
        <input type="number" step="any" name="listing[longitude]" id="longitude" class="form-control form-control-sm" placeholder="E.g., 73.7667">
      </div>
    </div>

    <!-- Amenities Checkboxes -->
    <div class="mb-4">
      <label class="form-label fw-semibold">Amenities Offered</label>
      <div class="row g-2">
        <% 
          const availableAmenities = [
            "Wifi", "Pool", "Air conditioning", "Kitchen", "Free parking", "TV",
            "Dedicated workspace", "Mountain view", "Sea view", "Beach access",
            "Indoor fireplace", "BBQ grill", "Balcony", "Breakfast included", "Elevator"
          ];
        %>
        <% for (let a of availableAmenities) { %>
          <div class="col-6 col-md-4">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" name="amenities" value="<%= a %>" id="amenity-<%= a.replace(/\s+/g, '') %>" <%= ["Wifi", "Air conditioning", "Kitchen"].includes(a) ? "checked" : "" %>>
              <label class="form-check-label small" for="amenity-<%= a.replace(/\s+/g, '') %>">
                <%= a %>
              </label>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Publication Toggles -->
    <div class="row g-3 mb-4 p-3 bg-light rounded-3 border">
      <div class="col-6">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="isPublished" id="isPublished" checked>
          <label class="form-check-label fw-semibold" for="isPublished">Publish immediately</label>
          <small class="d-block text-muted">Listing will appear on the public marketplace.</small>
        </div>
      </div>
      <div class="col-6">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" name="featured" id="featured">
          <label class="form-check-label fw-semibold" for="featured">Mark as Featured</label>
          <small class="d-block text-muted">Promoted on homepage.</small>
        </div>
      </div>
    </div>

    <div class="d-flex gap-2">
      <button type="submit" class="btn btn-danger px-4 py-2 fw-semibold" style="background-color: #fe424d; border-color: #fe424d;">
        <i class="fa-solid fa-cloud-arrow-up me-1"></i> Save & Publish Listing
      </button>
      <a href="/admin/listings" class="btn btn-outline-secondary px-4 py-2">Cancel</a>
    </div>
  </form>
</div>
