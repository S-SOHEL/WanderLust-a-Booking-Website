<% layout("/layouts/boilerplate") %>

<% const currentTab = 'users'; %>
<%- include("./adminNav.ejs", { currentTab }) %>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h4 class="fw-bold mb-1">User & Role Management</h4>
      <p class="text-muted small mb-0">Total registered platform users: <%= users.length %></p>
    </div>
  </div>

  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead class="table-light">
        <tr>
          <th>User</th>
          <th>Email Address</th>
          <th>Role</th>
          <th>Total Bookings</th>
          <th>Joined Date</th>
          <th class="text-end">Role Action</th>
        </tr>
      </thead>
      <tbody>
        <% for (let u of users) { %>
          <tr>
            <td>
              <div class="d-flex align-items-center">
                <div class="rounded-circle bg-secondary bg-opacity-25 text-dark d-flex align-items-center justify-content-center me-3" style="width: 38px; height: 38px; font-weight: 600;">
                  <%= u.username.charAt(0).toUpperCase() %>
                </div>
                <div>
                  <span class="fw-bold d-block">@<%= u.username %></span>
                  <% if (u._id.equals(currUser._id)) { %>
                    <span class="badge bg-info text-dark" style="font-size: 0.65rem;">You</span>
                  <% } %>
                </div>
              </div>
            </td>
            <td><%= u.email %></td>
            <td>
              <% if (u.role === 'admin') { %>
                <span class="badge bg-danger"><i class="fa-solid fa-shield-halved me-1"></i>Administrator</span>
              <% } else if (u.role === 'host') { %>
                <span class="badge bg-primary"><i class="fa-solid fa-house-user me-1"></i>Property Host</span>
              <% } else { %>
                <span class="badge bg-secondary"><i class="fa-solid fa-user me-1"></i>Standard User</span>
              <% } %>
            </td>
            <td>
              <span class="fw-semibold"><%= bookingCountMap[u._id.toString()] || 0 %> trip(s)</span>
            </td>
            <td>
              <small class="text-muted"><%= new Date(u.createdAt || Date.now()).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %></small>
            </td>
            <td class="text-end">
              <% if (u._id.equals(currUser._id)) { %>
                <span class="text-muted small fst-italic">Current Session</span>
              <% } else { %>
                <form action="/admin/users/<%= u._id %>/toggle-role?_method=PATCH" method="POST" class="d-inline" onsubmit="return confirm('Change role for @<%= u.username %> to <%= u.role === 'admin' ? 'USER' : 'ADMIN' %>?');">
                  <% if (u.role === 'admin') { %>
                    <button class="btn btn-sm btn-outline-warning">
                      <i class="fa-solid fa-user-minus me-1"></i> Demote to User
                    </button>
                  <% } else { %>
                    <button class="btn btn-sm btn-outline-danger">
                      <i class="fa-solid fa-user-shield me-1"></i> Promote to Admin
                    </button>
                  <% } %>
                </form>
              <% } %>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>
