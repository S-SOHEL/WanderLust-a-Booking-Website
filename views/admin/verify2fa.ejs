<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5 justify-content-center">
  <div class="col-12 col-md-6 col-lg-5">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="bg-dark text-white p-4 text-center">
        <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px; font-size: 1.5rem; background-color: #fe424d !important;">
          <i class="fa-solid fa-mobile-screen-button"></i>
        </div>
        <h4 class="fw-bold mb-1">Two-Factor Authentication</h4>
        <p class="text-white-50 small mb-0">Enter the verification code from your authenticator app</p>
      </div>

      <div class="card-body p-4 p-md-5">
        <form action="/admin/verify-2fa" method="POST" id="verify2faForm">
          <div class="mb-4 text-center">
            <label for="totpCode" class="form-label fw-semibold text-secondary small text-uppercase letter-spacing-1 mb-2">
              6-Digit Authenticator Code
            </label>
            <input 
              type="text" 
              class="form-control text-center fw-bold fs-3 letter-spacing-2" 
              id="totpCode" 
              name="totpCode" 
              placeholder="000000" 
              maxlength="6" 
              pattern="[0-9]{6}" 
              inputmode="numeric" 
              autocomplete="one-time-code" 
              autofocus />
            <small class="text-muted d-block mt-2">
              Compatible with Google Authenticator, Microsoft Authenticator, and Aegis.
            </small>
          </div>

          <button type="submit" class="btn btn-dark w-100 py-3 fw-bold rounded-3 mb-3 shadow-sm" style="background-color: #fe424d !important; border: none;">
            <i class="fa-solid fa-shield-check me-2"></i>Verify &amp; Continue
          </button>

          <!-- Recovery Code Fallback Accordion -->
          <div class="accordion accordion-flush mt-3 mb-3" id="recoveryAccordion">
            <div class="accordion-item border-0">
              <h2 class="accordion-header">
                <button class="accordion-button collapsed px-0 py-2 small text-secondary bg-transparent" type="button" data-bs-toggle="collapse" data-bs-target="#collapseRecovery">
                  <i class="fa-solid fa-key me-2 text-danger"></i>Lost device? Use a Recovery Code
                </button>
              </h2>
              <div id="collapseRecovery" class="accordion-collapse collapse" data-bs-parent="#recoveryAccordion">
                <div class="accordion-body px-0 pt-2 pb-0">
                  <div class="mb-3">
                    <label for="recoveryCode" class="form-label small fw-semibold text-muted">Single-use Recovery Code</label>
                    <input 
                      type="text" 
                      class="form-control font-monospace text-uppercase" 
                      id="recoveryCode" 
                      name="recoveryCode" 
                      placeholder="WNDR-XXXX-XXXX" />
                    <small class="text-muted d-block mt-1" style="font-size: 0.72rem;">
                      Enter one of your 14-character recovery codes generated during enrollment.
                    </small>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </form>

        <div class="text-center pt-3 border-top">
          <a href="/admin/login" class="text-secondary small text-decoration-none">
            <i class="fa-solid fa-arrow-left me-1"></i>Back to Admin Login
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
