<% layout("/layouts/boilerplate") %>

<% const currentTab = 'listings'; %>
<%- include("./adminNav.ejs", { currentTab }) %>

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
  <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
      <h4 class="fw-bold mb-1">Property Inventory Management</h4>
      <p class="text-muted small mb-0">Total properties registered: <%= listings.length %></p>
    </div>
    <a href="/admin/listings/new" class="btn btn-danger px-4 py-2 rounded-3" style="background-color: #fe424d; border-color: #fe424d;">
      <i class="fa-solid fa-plus me-1"></i> Add New Property
    </a>
  </div>

  <!-- Search & Filter Controls -->
  <form method="GET" action="/admin/listings" class="row g-2 mb-4 bg-light p-3 rounded-3 border">
    <div class="col-12 col-md-4">
      <div class="input-group">
        <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
        <input type="text" name="search" class="form-control" placeholder="Search by title or location..." value="<%= search %>">
      </div>
    </div>
    <div class="col-6 col-md-3">
      <select name="category" class="form-select">
        <option value="All" <%= category === 'All' ? 'selected' : '' %>>All Categories</option>
        <% const cats = ["Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Domes", "Boats"]; %>
        <% for (let c of cats) { %>
          <option value="<%= c %>" <%= category === c ? 'selected' : '' %>><%= c %></option>
        <% } %>
      </select>
    </div>
    <div class="col-6 col-md-3">
      <select name="status" class="form-select">
        <option value="all" <%= status === 'all' ? 'selected' : '' %>>All Statuses</option>
        <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>Pending Review</option>
        <option value="approved" <%= status === 'approved' ? 'selected' : '' %>>Approved</option>
        <option value="rejected" <%= status === 'rejected' ? 'selected' : '' %>>Rejected</option>
        <option value="published" <%= status === 'published' ? 'selected' : '' %>>Published Only</option>
        <option value="unpublished" <%= status === 'unpublished' ? 'selected' : '' %>>Unpublished Only</option>
      </select>
    </div>
    <div class="col-12 col-md-2 d-flex gap-2">
      <button type="submit" class="btn btn-dark w-100">Filter</button>
      <a href="/admin/listings" class="btn btn-outline-secondary">Reset</a>
    </div>
  </form>

  <!-- Listings Table -->
  <% if (listings.length === 0) { %>
    <div class="text-center py-5">
      <i class="fa-regular fa-building text-muted" style="font-size: 3rem;"></i>
      <h5 class="mt-3">No listings match your filter</h5>
      <p class="text-muted small">Try adjusting your search criteria or add a new property listing.</p>
      <a href="/admin/listings" class="btn btn-outline-dark btn-sm">Clear Filters</a>
    </div>
  <% } else { %>
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>Property</th>
            <th>Host</th>
            <th>Type</th>
            <th>Price / Night</th>
            <th>Review Status</th>
            <th>Live Visibility</th>
            <th class="text-end">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% for (let l of listings) { %>
            <tr>
              <td>
                <div class="d-flex align-items-center">
                  <img src="<%= l.image && l.image.url ? l.image.url : '' %>" class="rounded-3 me-3" style="width: 60px; height: 50px; object-fit: cover;" alt="">
                  <div>
                    <a href="/listings/<%= l._id %>" target="_blank" class="fw-bold text-dark text-decoration-none d-block">
                      <%= l.title %>
                    </a>
                    <small class="text-muted"><i class="fa-solid fa-location-dot me-1"></i><%= l.location %>, <%= l.country %></small>
                    <% 
                      const isUnresolved = (l.isLocationResolved === false || !l.geometry || !l.geometry.coordinates || l.geometry.coordinates.length < 2);
                      const isLegacyMumbai = (!isUnresolved && Math.abs(l.geometry.coordinates[0] - 72.8777) < 0.01 && Math.abs(l.geometry.coordinates[1] - 19.0760) < 0.01 && !((l.location || '').toLowerCase().includes('mumbai') || (l.location || '').toLowerCase().includes('bombay')));
                    %>
                    <% if (isUnresolved) { %>
                      <div>
                        <span class="badge bg-danger text-white mt-1" style="font-size: 0.68rem;" title="<%= l.locationResolutionNotes || 'Coordinates unresolved' %>">
                          <i class="fa-solid fa-triangle-exclamation me-1"></i>Unresolved Location
                        </span>
                      </div>
                    <% } else if (isLegacyMumbai) { %>
                      <div>
                        <span class="badge bg-warning text-dark mt-1" style="font-size: 0.68rem;" title="Legacy Mumbai coordinates detected for non-Mumbai listing. Manual review recommended.">
                          <i class="fa-solid fa-map-pin me-1"></i>Review Coordinates
                        </span>
                      </div>
                    <% } %>
                  </div>
                </div>
              </td>
              <td>
                <span class="d-block fw-semibold small">@<%= l.owner ? l.owner.username : 'admin' %></span>
                <span class="badge bg-light text-muted border" style="font-size: 0.7rem;"><%= l.owner && l.owner.role ? l.owner.role : 'admin' %></span>
              </td>
              <td>
                <span class="badge bg-light text-dark border"><%= l.propertyType || "Apartment" %></span>
                <small class="text-muted d-block" style="font-size: 0.72rem;"><%= l.category %></small>
              </td>
              <td class="fw-bold">&#8377;<%= l.price ? l.price.toLocaleString("en-IN") : 0 %></td>
              <td>
                <% if (l.status === 'pending') { %>
                  <div class="d-flex align-items-center gap-1">
                    <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i>Pending</span>
                    <form action="/admin/listings/<%= l._id %>/approve?_method=PATCH" method="POST" class="d-inline">
                      <button class="btn btn-sm btn-success py-0 px-2" title="Approve and Publish">
                        <i class="fa-solid fa-check"></i>
                      </button>
                    </form>
                    <button class="btn btn-sm btn-outline-danger py-0 px-2" data-bs-toggle="modal" data-bs-target="#rejectListingModal-<%= l._id %>" title="Reject Listing">
                      <i class="fa-solid fa-xmark"></i>
                    </button>
                  </div>

                  <!-- Reject Listing Modal -->
                  <div class="modal fade text-start" id="rejectListingModal-<%= l._id %>" tabindex="-1">
                    <div class="modal-dialog">
                      <div class="modal-content">
                        <form action="/admin/listings/<%= l._id %>/reject?_method=PATCH" method="POST">
                          <div class="modal-header">
                            <h5 class="modal-title">Reject Listing: <%= l.title %></h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                          </div>
                          <div class="modal-body">
                            <label class="form-label fw-semibold">Reason for Rejection</label>
                            <textarea name="rejectionReason" class="form-control" rows="3" placeholder="Explain why this listing does not meet standards (e.g. low-res images, pricing errors)..." required></textarea>
                          </div>
                          <div class="modal-footer">
                            <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-danger btn-sm">Confirm Rejection</button>
                          </div>
                        </form>
                      </div>
                    </div>
                  </div>
                <% } else if (l.status === 'approved') { %>
                  <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Approved</span>
                <% } else if (l.status === 'rejected') { %>
                  <span class="badge bg-danger" title="<%= l.rejectionReason %>"><i class="fa-solid fa-xmark me-1"></i>Rejected</span>
                  <form action="/admin/listings/<%= l._id %>/approve?_method=PATCH" method="POST" class="d-inline ms-1">
                    <button class="btn btn-sm btn-outline-success py-0 px-1" title="Re-approve Listing">
                      <i class="fa-solid fa-rotate-left"></i>
                    </button>
                  </form>
                <% } else { %>
                  <span class="badge bg-secondary">Draft</span>
                <% } %>
              </td>
              <td>
                <form action="/admin/listings/<%= l._id %>/toggle-publish?_method=PATCH" method="POST" class="d-inline">
                  <% if (l.isPublished !== false) { %>
                    <button class="btn btn-sm btn-outline-success" title="Click to Unpublish">
                      <i class="fa-solid fa-globe me-1"></i> Published
                    </button>
                  <% } else { %>
                    <button class="btn btn-sm btn-outline-secondary" title="Click to Publish">
                      <i class="fa-solid fa-eye-slash me-1"></i> Hidden
                    </button>
                  <% } %>
                </form>
              </td>
              <td class="text-end">
                <div class="btn-group">
                  <a href="/listings/<%= l._id %>" target="_blank" class="btn btn-sm btn-outline-secondary" title="Preview Public Page">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                  </a>
                  <a href="/admin/listings/<%= l._id %>/edit" class="btn btn-sm btn-outline-primary" title="Edit Property">
                    <i class="fa-solid fa-pen-to-square"></i>
                  </a>
                  <form action="/admin/listings/<%= l._id %>?_method=DELETE" method="POST" class="d-inline" onsubmit="return confirm('Are you sure you want to permanently delete this listing?');">
                    <button class="btn btn-sm btn-outline-danger" title="Delete Property">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </div>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
