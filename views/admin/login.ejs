<% layout("/layouts/boilerplate") %>

<% if (typeof turnstileSiteKey !== "undefined" && turnstileSiteKey) { %>
  <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<% } %>

<div class="row mt-4 mb-5 justify-content-center">
  <div class="col-12 col-md-6 col-lg-5">
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">
      <div class="bg-dark text-white p-4 text-center">
        <div class="rounded-circle text-white d-inline-flex align-items-center justify-content-center mb-2" style="width: 56px; height: 56px; font-size: 1.5rem; background-color: #fe424d !important;">
          <i class="fa-solid fa-shield-halved"></i>
        </div>
        <h4 class="fw-bold mb-1">Admin Portal Access</h4>
        <p class="text-white-50 small mb-0">Protected with Mandatory 2-Factor Authentication (TOTP)</p>
      </div>

      <div class="card-body p-4 p-md-5">
        <form action="/admin/login" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="username" class="form-label fw-semibold">Admin Email, Mobile, or Username</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fa-solid fa-user-shield text-muted"></i></span>
              <input 
                class="form-control" 
                id="username"
                name="username" 
                type="text" 
                placeholder="admin or admin@wanderlust.com"
                required 
                autofocus />
            </div>
            <div class="invalid-feedback">Please enter your admin credentials.</div>
          </div>

          <div class="mb-3">
            <label for="password" class="form-label fw-semibold">Password</label>
            <div class="input-group">
              <span class="input-group-text bg-light"><i class="fa-solid fa-key text-muted"></i></span>
              <input 
                class="form-control"
                id="password"
                name="password"
                type="password"
                placeholder="Enter admin password"
                required />
            </div>
            <div class="invalid-feedback">Please enter your password.</div>
          </div>

          <% if (typeof turnstileSiteKey !== "undefined" && turnstileSiteKey) { %>
            <div class="mb-3 d-flex justify-content-center">
              <div class="cf-turnstile" data-sitekey="<%= turnstileSiteKey %>"></div>
            </div>
          <% } %>

          <div class="d-flex align-items-center justify-content-between mb-4">
            <span class="badge bg-light text-dark border px-2 py-1 small">
              <i class="fa-solid fa-lock text-danger me-1"></i>Step 1 of 2: Password
            </span>
            <span class="small text-muted">
              <i class="fa-solid fa-shield me-1"></i>TOTP Required
            </span>
          </div>

          <button type="submit" class="btn btn-dark w-100 py-3 fw-bold rounded-3 mb-3 shadow-sm" style="background-color: #fe424d !important; border: none;">
            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Sign In &amp; Proceed to 2FA
          </button>
        </form>

        <div class="text-center pt-2 border-top">
          <small class="text-muted">
            Looking for public login? <a href="/login" class="text-danger fw-semibold" style="color: #fe424d !important;">Standard User Login</a>
          </small>
        </div>
      </div>
    </div>
  </div>
</div>
