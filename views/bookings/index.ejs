<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5">
  <div class="col-12 col-lg-10 offset-lg-1">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
      <div>
        <h2 class="fw-bold mb-1">My Reservations</h2>
        <p class="text-muted small mb-0">Track your booking requests, confirmed vacations, and trip history.</p>
      </div>
      <a href="/listings" class="btn btn-outline-dark rounded-pill px-3">
        <i class="fa-solid fa-magnifying-glass me-1"></i> Browse Stays
      </a>
    </div>

    <% if (bookings.length === 0) { %>
      <div class="text-center py-5 my-4 bg-light rounded-4 border">
        <i class="fa-solid fa-suitcase-rolling text-muted mb-3" style="font-size: 3.5rem;"></i>
        <h4 class="fw-bold">No trips booked yet</h4>
        <p class="text-muted small">From luxury apartments to hillside cabins, find your next getaway.</p>
        <a href="/listings" class="btn btn-danger px-4 py-2 mt-2 rounded-pill" style="background-color: #fe424d; border-color: #fe424d;">
          Browse Accommodations
        </a>
      </div>
    <% } else { %>
      <div class="row g-4">
        <% for (let booking of bookings) { %>
          <% const listing = booking.listing; %>
          <div class="col-12 col-md-6">
            <div class="card h-100 border rounded-4 overflow-hidden shadow-sm bg-white">
              <div class="position-relative">
                <img 
                  src="<%= listing && listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60' %>" 
                  class="card-img-top" 
                  style="height: 200px; object-fit: cover;" 
                  alt="<%= listing ? listing.title : 'Trip' %>">

                <!-- Booking Status Badge -->
                <div class="position-absolute top-0 end-0 m-3">
                  <% if (booking.status === 'Pending') { %>
                    <span class="badge bg-warning text-dark px-3 py-2 shadow-sm fs-6">
                      <i class="fa-solid fa-clock me-1"></i> Pending Approval
                    </span>
                  <% } else if (booking.status === 'Confirmed') { %>
                    <span class="badge bg-success px-3 py-2 shadow-sm fs-6">
                      <i class="fa-solid fa-circle-check me-1"></i> Confirmed
                    </span>
                  <% } else if (booking.status === 'Completed') { %>
                    <span class="badge bg-primary px-3 py-2 shadow-sm fs-6">
                      <i class="fa-solid fa-flag-checkered me-1"></i> Completed Stay
                    </span>
                  <% } else if (booking.status === 'Rejected') { %>
                    <span class="badge bg-danger px-3 py-2 shadow-sm fs-6" title="<%= booking.rejectionReason %>">
                      <i class="fa-solid fa-circle-xmark me-1"></i> Rejected
                    </span>
                  <% } else { %>
                    <span class="badge bg-secondary px-3 py-2 shadow-sm fs-6">
                      <i class="fa-solid fa-ban me-1"></i> Cancelled
                    </span>
                  <% } %>
                </div>

                <!-- Reference Badge -->
                <div class="position-absolute top-0 start-0 m-3">
                  <span class="badge bg-dark bg-opacity-75 font-monospace px-2 py-1">
                    #<%= booking.bookingRef %>
                  </span>
                </div>
              </div>

              <div class="card-body p-4 d-flex flex-column">
                <h5 class="card-title fw-bold mb-1">
                  <% if (listing) { %>
                    <a href="/listings/<%= listing._id %>" class="text-dark text-decoration-none">
                      <%= listing.title %>
                    </a>
                  <% } else { %>
                    <span class="text-muted">Property Archived</span>
                  <% } %>
                </h5>
                <p class="text-muted small mb-3">
                  <i class="fa-solid fa-location-dot me-1 text-danger"></i>
                  <%= listing ? listing.location + ', ' + listing.country : 'N/A' %>
                </p>

                <div class="bg-light p-3 rounded-3 small mb-3">
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Check-in:</span>
                    <span class="fw-semibold"><%= new Date(booking.checkIn).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %></span>
                  </div>
                  <div class="d-flex justify-content-between mb-1">
                    <span class="text-muted">Checkout:</span>
                    <span class="fw-semibold"><%= new Date(booking.checkOut).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %></span>
                  </div>
                  <div class="d-flex justify-content-between">
                    <span class="text-muted">Guests & Nights:</span>
                    <span class="fw-semibold"><%= booking.totalGuests %> guest(s) &middot; <%= booking.totalNights %> night(s)</span>
                  </div>
                </div>

                <% if (booking.status === 'Rejected' && booking.rejectionReason) { %>
                  <div class="alert alert-danger py-2 px-3 small mb-3">
                    <strong>Reason:</strong> <%= booking.rejectionReason %>
                  </div>
                <% } else if (booking.status === 'Pending') { %>
                  <div class="alert alert-warning py-2 px-3 small mb-3">
                    <i class="fa-solid fa-info-circle me-1"></i> Waiting for host confirmation. You won't be charged until approved.
                  </div>
                <% } %>

                <div class="mt-auto d-flex justify-content-between align-items-center pt-3 border-top">
                  <div>
                    <span class="text-muted small d-block">Total Estimated Cost</span>
                    <span class="fw-bold fs-5 text-dark">&#8377;<%= booking.totalPrice ? booking.totalPrice.toLocaleString("en-IN") : 0 %></span>
                  </div>

                  <div class="d-flex gap-2">
                    <% if (listing) { %>
                      <a href="/listings/<%= listing._id %>" class="btn btn-sm btn-outline-dark">
                        Details
                      </a>
                    <% } %>
                    <% if (['Pending', 'Confirmed'].includes(booking.status)) { %>
                      <form action="/bookings/<%= booking._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to cancel this reservation?');">
                        <button class="btn btn-sm btn-outline-danger">
                          <i class="fa-solid fa-xmark me-1"></i> Cancel
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      </div>
    <% } %>
  </div>
</div>
