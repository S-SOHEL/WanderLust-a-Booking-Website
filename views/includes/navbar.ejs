          <i class="fa-solid fa-shield-halved"></i>
          <span>Admin</span>
          <% if (typeof adminAlertCount !== 'undefined' && adminAlertCount > 0) { %>
            <span class="badge rounded-pill bg-danger" style="font-size: 0.65rem;"><%= adminAlertCount %></span>
