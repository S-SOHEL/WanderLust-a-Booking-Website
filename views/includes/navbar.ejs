              <li class="user-dropdown-header">
                <div class="fw-bold text-dark text-truncate" style="max-width: 200px;">
                  <%= currUser.fullName && currUser.fullName.trim() ? currUser.fullName.trim() : (currUser.username || "Guest User") %>
                </div>
                <div class="text-muted small text-truncate" style="max-width: 200px; font-size: 0.75rem;">
                  <%= currUser.email %>
                </div>
              </li>
              <li>
                <a class="dropdown-item" href="/bookings">
                  <i class="fa-solid fa-suitcase-rolling me-2 text-muted"></i>My Trips / Bookings
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/profile#wishlist">
                  <i class="fa-solid fa-heart me-2 text-danger"></i>My Wishlist
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/profile">
                  <i class="fa-regular fa-user me-2 text-muted"></i>Manage Profile
                </a>
              </li>
              <li>
                <a class="dropdown-item" href="/listings/new">
                  <i class="fa-solid fa-house-chimney-medical me-2 text-muted"></i>List a Property
                </a>
              </li>
              <% if (currUser.role === 'admin') { %>
                <li><hr class="dropdown-divider my-1"></li>
                <li>
                  <a class="dropdown-item text-danger fw-bold" href="/admin/dashboard">
                    <i class="fa-solid fa-shield-halved me-2"></i>Admin Dashboard
                  </a>
                </li>
              <% } %>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="dropdown-item text-danger" href="/logout">
                  <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Log out
                </a>
              </li>
