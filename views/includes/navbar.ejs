        <a class="nav-link nav-link-host px-3 text-nowrap" href="/listings/new">
          <span class="d-none d-lg-inline">Airbnb your home</span>
          <span class="d-lg-none">List your property</span>
        </a>

        <% if (currUser) { %>
          <!-- Admin Portal Quick Pill (for Admins) -->
          <% if (currUser.role === 'admin') { %>
            <a class="nav-link text-danger fw-bold position-relative px-2 text-nowrap" href="/admin/dashboard" title="Admin Portal">
              <i class="fa-solid fa-shield-halved me-1"></i>Admin Portal
