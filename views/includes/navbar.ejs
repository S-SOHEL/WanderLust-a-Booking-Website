        <div class="brand-icon-wrapper">
          <i class="fa-solid fa-hotel" style="font-size: 1.15rem;"></i>
        </div>
        <span class="brand-text">WanderLust</span>
      </a>

      <div class="d-none d-md-flex align-items-center">
        <a class="nav-link d-flex align-items-center gap-1" href="/listings">
          <i class="fa-solid fa-house-chimney text-muted me-1" style="font-size: 0.85rem;"></i>
          <span>Find Homes</span>
        </a>
      </div>
