              <div class="user-menu-avatar" style="background-color: #717171;">
                <i class="fa-solid fa-user text-white" style="font-size: 13px;"></i>
              </div>
            </button>

            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu shadow-lg" aria-labelledby="loggedOutMenuDropdown">
              <li>
                <a class="dropdown-item fw-bold" href="/signup">Sign up</a>
              </li>
              <li>
                <a class="dropdown-item" href="/login">Log in</a>
              </li>
              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="dropdown-item" href="/listings/new">Airbnb your home</a>
              </li>
              <li>
                <a class="dropdown-item" href="/listings">Find Homes</a>
              </li>
            </ul>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</nav>
