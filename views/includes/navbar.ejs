</nav>

<!-- Mobile Offcanvas Drawer Navigation (< 768px) -->
<div class="offcanvas offcanvas-end wl-mobile-drawer d-md-none" tabindex="-1" id="mobileNavDrawer" aria-labelledby="mobileNavDrawerLabel">
  <div class="offcanvas-header border-bottom py-3 px-4">
    <div class="d-flex align-items-center gap-2" id="mobileNavDrawerLabel">
      <div class="brand-icon-wrapper" style="width: 32px; height: 32px;">
        <i class="fa-solid fa-hotel" style="font-size: 0.9rem;"></i>
      </div>
      <span class="brand-text m-0" style="font-size: 1.15rem;">WanderLust</span>
    </div>
    <button type="button" class="btn-close shadow-none" data-bs-dismiss="offcanvas" aria-label="Close navigation menu"></button>
  </div>

  <div class="offcanvas-body px-3 py-3 d-flex flex-column">
    <% if (currUser) { %>
      <div class="d-flex align-items-center gap-3 p-3 bg-light rounded-4 mb-3 border">
        <% if (currUser.profileImage && currUser.profileImage.url) { %>
          <img src="<%= currUser.profileImage.url %>" class="rounded-circle flex-shrink-0" style="width: 46px; height: 46px; object-fit: cover;" alt="<%= currUser.fullName || currUser.username %>">
        <% } else { %>
          <div class="rounded-circle text-white d-flex align-items-center justify-content-center fw-bold flex-shrink-0" style="width: 46px; height: 46px; font-size: 1.1rem; background: linear-gradient(135deg, #fe424d, #ff5a5f);">
            <%= ((currUser.fullName && currUser.fullName.trim()) ? currUser.fullName.trim()[0] : (currUser.username || "U")[0]).toUpperCase() %>
          </div>
        <% } %>
        <div class="min-w-0">
          <div class="fw-bold text-dark text-truncate"><%= currUser.fullName && currUser.fullName.trim() ? currUser.fullName.trim() : currUser.username %></div>
          <div class="text-muted small text-truncate"><%= currUser.email %></div>
        </div>
      </div>
    <% } else { %>
      <div class="d-grid gap-2 mb-3">
        <a href="/login" class="btn btn-primary-custom py-2 fw-semibold">Log in</a>
        <a href="/signup" class="btn btn-outline-dark rounded-3 py-2 fw-semibold">Create an account</a>
      </div>
    <% } %>

    <nav class="wl-drawer-links" aria-label="Mobile menu links">
      <a class="wl-drawer-link" href="/listings">
        <i class="fa-solid fa-compass"></i><span>Explore Stays</span>
      </a>
      <% if (currUser) { %>
        <a class="wl-drawer-link" href="/profile#wishlist">
          <i class="fa-solid fa-heart text-danger"></i><span>My Wishlist</span>
        </a>
        <a class="wl-drawer-link" href="/bookings">
          <i class="fa-solid fa-suitcase-rolling"></i><span>My Trips</span>
        </a>
        <a class="wl-drawer-link" href="/profile">
          <i class="fa-regular fa-user"></i><span>Profile &amp; Settings</span>
        </a>
        <a class="wl-drawer-link" href="/profile#properties">
          <i class="fa-solid fa-building-user"></i><span>My Hosted Properties</span>
        </a>
      <% } %>
      <a class="wl-drawer-link" href="/listings/new">
        <i class="fa-solid fa-house-chimney-medical text-danger"></i><span>Host Your Property</span>
      </a>

      <% if (currUser && currUser.role === 'admin') { %>
        <hr class="my-2">
        <div class="px-3 py-1 text-uppercase fw-bold text-muted" style="font-size: 0.7rem; letter-spacing: 0.5px;">Administration</div>
        <a class="wl-drawer-link text-danger fw-semibold" href="/admin/dashboard">
          <i class="fa-solid fa-shield-halved"></i>
          <span>Admin Dashboard</span>
          <% if (typeof adminAlertCount !== 'undefined' && adminAlertCount > 0) { %>
            <span class="badge rounded-pill bg-danger ms-auto"><%= adminAlertCount %></span>
          <% } %>
        </a>
        <a class="wl-drawer-link" href="/admin/listings">
          <i class="fa-solid fa-hotel"></i><span>Manage Properties</span>
        </a>
        <a class="wl-drawer-link" href="/admin/remediation">
          <i class="fa-solid fa-clipboard-check"></i><span>Remediation Queue</span>
        </a>
      <% } %>
    </nav>

    <% if (currUser) { %>
      <div class="mt-auto pt-3 border-top">
        <a href="/logout" class="btn btn-outline-danger w-100 rounded-3 py-2 fw-semibold">
          <i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Log out
        </a>
      </div>
    <% } %>
  </div>
</div>
