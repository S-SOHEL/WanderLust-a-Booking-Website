              <li><hr class="dropdown-divider my-1"></li>
              <li>
                <a class="dropdown-item" href="/listings/new">Host your home</a>
              </li>
              <li>
                <a class="dropdown-item" href="/listings">Find Homes</a>
              </li>
            </ul>
