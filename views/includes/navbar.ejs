              <% if (currUser.profileImage && currUser.profileImage.url) { %>
                <img src="<%= currUser.profileImage.url %>" class="user-menu-avatar" alt="<%= currUser.fullName || currUser.username %>">
              <% } else { %>
                <div class="user-menu-avatar" style="background: linear-gradient(135deg, #fe424d, #ff5a5f);">
                  <%= ((currUser.fullName && currUser.fullName.trim()) ? currUser.fullName.trim()[0] : (currUser.username || "U")[0]).toUpperCase() %>
                </div>
              <% } %>
            </button>

            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu shadow-lg" aria-labelledby="userMenuDropdown">
              <li class="user-dropdown-header">
                <div class="fw-bold text-dark text-truncate" style="max-width: 200px;">
                  <%= currUser.fullName && currUser.fullName.trim() ? currUser.fullName.trim() : (currUser.username || "Guest User") %>
                </div>
                <div class="text-muted small text-truncate" style="max-width: 200px; font-size: 0.75rem;">
                  <%= currUser.email %>
                </div>
              </li>
              <li>
                <a class="dropdown-item" href="/bookings">
                  <i class="fa-solid fa-suitcase-rolling me-2 text-muted"></i>My Trips / Bookings
