<!-- Mobile Backdrop for WanderAI Bottom Sheet -->
<div id="aiBackdrop" class="wl-ai-backdrop" aria-hidden="true"></div>

<!-- Floating WanderAI Assistant Trigger & Responsive Chat Container -->
<div id="aiWidgetContainer" class="wl-ai-widget">
  <!-- Trigger Button: Compact circle on mobile, pill on desktop -->
  <button id="aiToggleBtn"
          type="button"
          class="wl-ai-trigger"
          aria-expanded="false"
          aria-controls="aiChatCard"
          aria-label="Open WanderAI Assistant"
          title="Ask WanderAI Assistant">
    <i class="fa-solid fa-wand-magic-sparkles"></i>
    <span class="wl-ai-trigger-label d-none d-md-inline">WanderAI</span>
  </button>

  <!-- Chat Window (Floating card on desktop, Bottom Sheet on mobile) -->
  <div id="aiChatCard" class="card border-0 shadow-lg overflow-hidden wl-ai-chat-card" role="dialog" aria-modal="true" aria-label="WanderAI Assistant">
    <!-- Mobile Sheet Drag Handle -->
    <div class="wl-ai-sheet-handle d-md-none" aria-hidden="true"><span></span></div>

    <!-- Chat Header -->
    <div class="card-header text-white p-3 border-0 d-flex justify-content-between align-items-center wl-ai-header">
      <div class="d-flex align-items-center gap-2 min-w-0">
        <div class="rounded-circle d-flex align-items-center justify-content-center text-white flex-shrink-0"
             style="width: 34px; height: 34px; background: linear-gradient(135deg, #fe424d, #e31c5f);">
          <i class="fa-solid fa-wand-magic-sparkles small"></i>
        </div>
        <div class="min-w-0">
          <h6 class="mb-0 fw-bold fs-6 text-truncate">WanderAI Assistant</h6>
          <small class="text-white-50 d-flex align-items-center gap-1" style="font-size: 0.72rem;">
            <span class="rounded-circle bg-success d-inline-block flex-shrink-0" style="width: 7px; height: 7px;"></span>
            <span class="text-truncate">Real-time WanderLust stays</span>
          </small>
        </div>
      </div>
      <button id="aiCloseBtn" type="button" class="btn btn-sm btn-link text-white text-decoration-none p-2 fs-5 lh-1" aria-label="Close WanderAI Assistant">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <!-- Chat Messages Container -->
    <div id="aiMessages" class="card-body p-3 overflow-y-auto d-flex flex-column gap-3 bg-light" style="flex: 1;">
      <!-- Welcome Message -->
      <div class="d-flex gap-2">
        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center flex-shrink-0"
             style="width: 30px; height: 30px; font-size: 0.75rem;">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div class="bg-white p-3 rounded-4 shadow-sm border" style="max-width: 85%; font-size: 0.88rem; line-height: 1.5;">
          Hello! I'm your WanderLust AI concierge. Ask me for property recommendations, budget stays, or private villas across India.
        </div>
      </div>

      <!-- Suggestion Chips -->
      <div id="aiChipsContainer" class="d-flex flex-wrap gap-2 mt-1 ps-1 ps-md-4">
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill bg-white py-1 px-3 ai-chip" style="font-size: 0.78rem;">
          Villas in Goa with pool
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill bg-white py-1 px-3 ai-chip" style="font-size: 0.78rem;">
          Cabins in Manali under &#8377;5000
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill bg-white py-1 px-3 ai-chip" style="font-size: 0.78rem;">
          Heritage Havelis in Jaipur
        </button>
        <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill bg-white py-1 px-3 ai-chip" style="font-size: 0.78rem;">
          Coorg coffee estates
        </button>
      </div>
    </div>

    <!-- Typing Indicator -->
    <div id="aiTypingIndicator" class="px-3 py-1 bg-light text-muted small d-none" style="font-size: 0.75rem;">
      <i class="fa-solid fa-circle-notch fa-spin me-1 text-danger"></i> Searching WanderLust inventory...
    </div>

    <!-- Chat Footer Input -->
    <div class="card-footer p-2 bg-white border-top wl-ai-input-bar">
      <form id="aiChatForm" class="d-flex align-items-center gap-2">
        <input type="text" id="aiQueryInput" class="form-control rounded-pill px-3 border"
               style="font-size: 16px;"
               placeholder="Ask for stays, locations, budgets..." autocomplete="off" maxlength="300" required>
        <button type="submit" id="aiSendBtn" class="btn btn-danger rounded-circle d-flex align-items-center justify-content-center flex-shrink-0"
                aria-label="Send message"
                style="width: 40px; height: 40px; background-color: #fe424d; border-color: #fe424d;">
          <i class="fa-solid fa-paper-plane small"></i>
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  (function () {
    const toggleBtn = document.getElementById("aiToggleBtn");
    const closeBtn = document.getElementById("aiCloseBtn");
    const chatCard = document.getElementById("aiChatCard");
    const backdrop = document.getElementById("aiBackdrop");
    const widget = document.getElementById("aiWidgetContainer");
    const chatForm = document.getElementById("aiChatForm");
    const queryInput = document.getElementById("aiQueryInput");
    const messages = document.getElementById("aiMessages");
    const typingIndicator = document.getElementById("aiTypingIndicator");
    const chips = document.querySelectorAll(".ai-chip");

    if (!toggleBtn || !chatCard || !chatForm) return;

    function openChat() {
      chatCard.classList.add("is-open");
      if (widget) widget.classList.add("is-open");
      if (backdrop) backdrop.classList.add("is-open");
      toggleBtn.setAttribute("aria-expanded", "true");
      if (window.innerWidth < 768) {
        document.body.classList.add("wl-ai-sheet-open");
      }
      setTimeout(() => {
        queryInput.focus();
        scrollToBottom();
      }, 60);
    }

    function closeChat() {
      chatCard.classList.remove("is-open");
      if (widget) widget.classList.remove("is-open");
      if (backdrop) backdrop.classList.remove("is-open");
      toggleBtn.setAttribute("aria-expanded", "false");
      document.body.classList.remove("wl-ai-sheet-open");
    }

    toggleBtn.addEventListener("click", () => {
      if (chatCard.classList.contains("is-open")) {
        closeChat();
      } else {
        openChat();
      }
    });

    closeBtn.addEventListener("click", closeChat);
    if (backdrop) {
      backdrop.addEventListener("click", closeChat);
    }

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && chatCard.classList.contains("is-open")) {
        closeChat();
        toggleBtn.focus();
      }
    });

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        const text = chip.textContent.trim();
        queryInput.value = "";
        submitQuery(text);
      });
    });

    chatForm.addEventListener("submit", (e) => {
      e.preventDefault();
      const text = queryInput.value.trim();
      if (!text) return;
      queryInput.value = "";
      submitQuery(text);
    });

    function setSubmitting(isSubmitting) {
      queryInput.disabled = isSubmitting;
      const sendBtn = document.getElementById("aiSendBtn");
      if (sendBtn) sendBtn.disabled = isSubmitting;
      chips.forEach((c) => { c.disabled = isSubmitting; });
      if (isSubmitting) {
        typingIndicator.classList.remove("d-none");
      } else {
        typingIndicator.classList.add("d-none");
      }
    }

    function submitQuery(userText) {
      appendMessage("user", userText);
      setSubmitting(true);
      scrollToBottom();

      fetch("/api/ai/chat", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "Accept": "application/json",
          "X-Requested-With": "XMLHttpRequest",
        },
        body: JSON.stringify({ message: userText }),
      })
        .then(async (res) => {
          const contentType = res.headers.get("content-type") || "";
          let data = null;
          if (contentType.includes("application/json")) {
            data = await res.json();
          } else {
            throw new Error("WanderAI concierge received an unexpected response format. Please try again.");
          }
          if (!res.ok) {
            throw new Error((data && data.error) || "Failed to get AI response");
          }
          return data;
        })
        .then((data) => {
          appendAssistantReply(data);
          scrollToBottom();
        })
        .catch((err) => {
          appendMessage("assistant", (err.message || "Something went wrong. Please try again."));
          scrollToBottom();
        })
        .finally(() => {
          setSubmitting(false);
          queryInput.focus();
        });
    }

    function appendMessage(sender, text) {
      const msgDiv = document.createElement("div");
      msgDiv.className = "d-flex gap-2 " + (sender === "user" ? "justify-content-end" : "");

      if (sender === "assistant") {
        msgDiv.innerHTML = `
          <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 30px; height: 30px; font-size: 0.75rem;">
            <i class="fa-solid fa-robot"></i>
          </div>
          <div class="bg-white p-3 rounded-4 shadow-sm border" style="max-width: 85%; font-size: 0.88rem; line-height: 1.5;">
            ${formatMarkdown(text)}
          </div>
        `;
      } else {
        msgDiv.innerHTML = `
          <div class="bg-danger text-white p-3 rounded-4 shadow-sm" style="max-width: 80%; font-size: 0.88rem; background-color: #fe424d !important;">
            ${escapeHtml(text)}
          </div>
        `;
      }
      messages.appendChild(msgDiv);
    }

    function appendAssistantReply(data) {
      const msgDiv = document.createElement("div");
      msgDiv.className = "d-flex gap-2";

      let cardsHtml = "";
      if (data.recommendations && data.recommendations.length > 0) {
        cardsHtml = `<div class="d-flex flex-column gap-2 mt-2">`;
        data.recommendations.forEach((item) => {
          cardsHtml += `
            <a href="/listings/${item._id}" class="text-decoration-none text-dark card border rounded-3 p-2 shadow-sm d-flex flex-row align-items-center gap-2" style="background: #fafafa;">
              <img src="${item.imageUrl || 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=300&q=80'}" class="rounded-2 flex-shrink-0" style="width: 55px; height: 50px; object-fit: cover;" alt="${escapeHtml(item.title)}" loading="lazy">
              <div class="overflow-hidden min-w-0">
                <span class="d-block fw-bold text-truncate" style="font-size: 0.82rem;">${escapeHtml(item.title)}</span>
                <small class="text-muted d-block text-truncate" style="font-size: 0.72rem;"><i class="fa-solid fa-location-dot text-danger me-1"></i>${escapeHtml(item.location)}</small>
                <span class="fw-bold text-danger" style="font-size: 0.78rem;">&#8377;${Number(item.price).toLocaleString("en-IN")}<small class="text-muted fw-normal"> / night</small></span>
              </div>
            </a>
          `;
        });
        cardsHtml += `</div>`;
      }

      msgDiv.innerHTML = `
        <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 30px; height: 30px; font-size: 0.75rem;">
          <i class="fa-solid fa-robot"></i>
        </div>
        <div class="bg-white p-3 rounded-4 shadow-sm border" style="max-width: 88%; font-size: 0.85rem; line-height: 1.5;">
          <div>${formatMarkdown(data.reply || "")}</div>
          ${cardsHtml}
        </div>
      `;
      messages.appendChild(msgDiv);
    }

    function formatMarkdown(text) {
      if (!text) return "";
      return escapeHtml(text)
        .replace(/\[([^\]]+)\]\((\/listings\/[a-fA-F0-9]{24})\)/g, '<a href="$2" class="text-danger fw-semibold">$1</a>')
        .replace(/\*\*(.*?)\*\*/g, "<strong>$1</strong>")
        .replace(/\n/g, "<br>");
    }

    function escapeHtml(str) {
      return (str || "").replace(/[&<>"']/g, function (m) {
        return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[m];
      });
    }

    function scrollToBottom() {
      messages.scrollTop = messages.scrollHeight;
    }
  })();
</script>
