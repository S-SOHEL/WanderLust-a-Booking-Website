<div class="wl-flash-stack">
  <% if (typeof success !== 'undefined' && success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0 col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-2 mb-2" role="alert">
      <i class="fa-solid fa-circle-check me-2"></i><%= success %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show rounded-3 shadow-sm border-0 col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-2 mb-2" role="alert">
      <i class="fa-solid fa-circle-exclamation me-2"></i><%= error %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (typeof warning !== 'undefined' && warning && warning.length) { %>
    <div class="alert alert-warning alert-dismissible fade show rounded-3 shadow-sm border-0 col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-2 mb-2" role="alert">
      <i class="fa-solid fa-triangle-exclamation me-2"></i><%= warning %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if (typeof info !== 'undefined' && info && info.length) { %>
    <div class="alert alert-info alert-dismissible fade show rounded-3 shadow-sm border-0 col-12 col-md-8 offset-md-2 col-lg-6 offset-lg-3 mt-2 mb-2" role="alert">
      <i class="fa-solid fa-circle-info me-2"></i><%= info %>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
</div>
