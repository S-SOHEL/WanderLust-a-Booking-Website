<% layout("/layouts/boilerplate") %>

<div class="row mt-4 mb-5 justify-content-center">
  <div class="col-12 col-md-7 col-lg-5">
    <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
      <div class="text-center mb-4">
        <h2 class="fw-bold mb-1">Welcome Back</h2>
        <p class="text-muted small">Log in to manage your bookings and property listings.</p>
      </div>

      <form action="/login" method="POST" class="needs-validation" novalidate id="loginForm">
        <!-- Dual Identifier (Email / Mobile / Username) -->
        <div class="mb-3">
          <label for="username" class="form-label fw-semibold">Email or Mobile Number</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-regular fa-user"></i></span>
            <input 
              type="text"
              class="form-control form-control-lg rounded-end-3 fs-6 border-start-0" 
              id="username"
              name="username"  
              placeholder="name@example.com or mobile"
              required />
            <div class="invalid-feedback">
              Please enter your email, mobile number, or username.
            </div>
          </div>
        </div>

        <!-- Password -->
        <div class="mb-4">
          <label for="password" class="form-label fw-semibold">Password</label>
          <div class="input-group">
            <span class="input-group-text bg-light border-end-0 text-muted"><i class="fa-solid fa-lock"></i></span>
            <input 
              type="password"
              class="form-control form-control-lg rounded-end-3 fs-6 border-start-0"
              id="password"
              name="password"
              placeholder="Enter your password"
              required />
            <div class="invalid-feedback">
              Please enter your password.
            </div>
          </div>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-danger w-100 py-3 rounded-3 fw-bold fs-6 shadow-sm" style="background-color: #fe424d; border-color: #fe424d;">
          Log In
        </button>

        <div class="text-center mt-4">
          <p class="text-muted small mb-2">
            Don't have an account yet? 
            <a href="/signup" class="text-dark fw-semibold text-decoration-none">Sign Up</a>
          </p>
          <p class="text-muted small mb-0">
            Platform administrator? 
            <a href="/admin/login" class="text-muted text-decoration-underline">Admin Portal</a>
          </p>
        </div>
      </form>
    </div>
  </div>
</div>
