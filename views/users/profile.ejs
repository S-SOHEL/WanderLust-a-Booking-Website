<% layout("/layouts/boilerplate") %>

<div class="container my-4">
  <div class="row g-4">
    <!-- Profile Sidebar -->
    <div class="col-12 col-lg-4">
      <div class="card border-0 shadow-sm rounded-4 p-4 text-center">
        <!-- Avatar -->
        <div class="mb-3 position-relative d-inline-block mx-auto">
          <% if (user.profileImage && user.profileImage.url) { %>
            <img src="<%= user.profileImage.url %>" alt="<%= user.fullName || user.username %>" class="rounded-circle shadow-sm" style="width: 110px; height: 110px; object-fit: cover; border: 3px solid #fe424d;">
          <% } else { %>
            <div class="rounded-circle text-white d-flex align-items-center justify-content-center shadow-sm fw-bold mx-auto" style="width: 110px; height: 110px; font-size: 2.5rem; background: linear-gradient(135deg, #fe424d 0%, #ff5a5f 100%);">
              <%= ((user.fullName || user.username || "U")[0]).toUpperCase() %>
            </div>
          <% } %>
        </div>

        <h4 class="fw-bold mb-1"><%= user.fullName || user.username %></h4>
        <p class="text-muted small mb-2"><i class="fa-regular fa-envelope me-1"></i><%= user.email %></p>
        <% if (user.mobile) { %>
          <p class="text-muted small mb-2"><i class="fa-solid fa-phone me-1"></i><%= user.mobile %></p>
        <% } %>

        <div class="mb-3">
          <% if (user.role === 'admin') { %>
            <span class="badge bg-danger rounded-pill px-3 py-2"><i class="fa-solid fa-shield-halved me-1"></i>Administrator</span>
          <% } else if (user.role === 'host') { %>
            <span class="badge bg-primary rounded-pill px-3 py-2"><i class="fa-solid fa-house-user me-1"></i>Property Host</span>
          <% } else { %>
            <span class="badge bg-secondary rounded-pill px-3 py-2"><i class="fa-regular fa-circle-check me-1"></i>Verified Member</span>
          <% } %>
        </div>

        <hr class="my-3">

        <div class="text-start small text-muted mb-3">
          <div class="d-flex justify-content-between mb-2">
            <span>Member Since:</span>
            <span class="fw-semibold text-dark"><%= new Date(user.createdAt || Date.now()).toLocaleDateString("en-IN", { month: "short", year: "numeric" }) %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>Total Reservations:</span>
            <span class="fw-semibold text-dark"><%= bookings.length %></span>
          </div>
          <div class="d-flex justify-content-between mb-2">
            <span>Saved in Wishlist:</span>
            <span id="sidebarWishlistCount" class="fw-semibold text-dark"><%= savedListings ? savedListings.length : 0 %></span>
          </div>
          <div class="d-flex justify-content-between">
            <span>Listed Properties:</span>
            <span class="fw-semibold text-dark"><%= myListings.length %></span>
          </div>
        </div>

        <div class="d-grid gap-2">
          <% if (user.role === 'admin') { %>
            <a href="/admin/dashboard" class="btn btn-dark rounded-3 py-2">
              <i class="fa-solid fa-gauge-high me-1"></i> Admin Dashboard
            </a>
          <% } %>
          <a href="/listings/new" class="btn btn-outline-danger rounded-3 py-2" style="color: #fe424d; border-color: #fe424d;">
            <i class="fa-solid fa-house-chimney me-1"></i> Host a New Property
          </a>
          <a href="/logout" class="btn btn-outline-secondary rounded-3 py-2">
            <i class="fa-solid fa-right-from-bracket me-1"></i> Log Out
          </a>
        </div>
      </div>
    </div>

    <!-- Main Content Tabs -->
    <div class="col-12 col-lg-8">
      <div class="card border-0 shadow-sm rounded-4 p-4">
        <ul class="nav nav-pills mb-4 pb-2 border-bottom flex-nowrap overflow-auto" id="profileTab" role="tablist">
          <li class="nav-item">
            <button class="nav-link active fw-semibold" id="reservations-tab" data-bs-toggle="pill" data-bs-target="#reservations" type="button" role="tab">
              <i class="fa-solid fa-suitcase-rolling me-1"></i> My Trips (<%= bookings.length %>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link fw-semibold" id="properties-tab" data-bs-toggle="pill" data-bs-target="#properties" type="button" role="tab">
              <i class="fa-solid fa-hotel me-1"></i> My Properties (<%= myListings.length %>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link fw-semibold" id="wishlist-tab" data-bs-toggle="pill" data-bs-target="#wishlist" type="button" role="tab">
              <i class="fa-solid fa-heart me-1 text-danger"></i> My Wishlist (<span id="tabWishlistCount"><%= savedListings ? savedListings.length : 0 %></span>)
            </button>
          </li>
          <li class="nav-item">
            <button class="nav-link fw-semibold" id="settings-tab" data-bs-toggle="pill" data-bs-target="#settings" type="button" role="tab">
              <i class="fa-solid fa-user-gear me-1"></i> Profile & Security
            </button>
          </li>
        </ul>

        <div class="tab-content" id="profileTabContent">
          <!-- 1. Reservations Tab -->
          <div class="tab-pane fade show active" id="reservations" role="tabpanel">
            <!-- Nested Subtabs for Upcoming, Completed, Cancelled -->
            <ul class="nav nav-underline mb-3" id="tripSubTabs" role="tablist">
              <li class="nav-item">
                <button class="nav-link active text-dark" data-bs-toggle="tab" data-bs-target="#upcomingTrips" type="button">
                  Active / Upcoming (<%= upcomingBookings.length %>)
                </button>
              </li>
              <li class="nav-item">
                <button class="nav-link text-dark" data-bs-toggle="tab" data-bs-target="#completedTrips" type="button">
                  Completed Stays (<%= completedBookings.length %>)
                </button>
              </li>
              <li class="nav-item">
                <button class="nav-link text-dark" data-bs-toggle="tab" data-bs-target="#cancelledTrips" type="button">
                  Cancelled / Declined (<%= cancelledBookings.length %>)
                </button>
              </li>
            </ul>

            <div class="tab-content">
              <!-- Upcoming Trips -->
              <div class="tab-pane fade show active" id="upcomingTrips">
                <% if (upcomingBookings.length === 0) { %>
                  <div class="text-center py-5">
                    <i class="fa-solid fa-suitcase text-muted mb-3" style="font-size: 2.75rem;"></i>
                    <h6 class="fw-bold">No active or upcoming trips</h6>
                    <p class="text-muted small">Ready for your next adventure? Find top rated homes and stays.</p>
                    <a href="/listings" class="btn btn-danger btn-sm rounded-pill px-4" style="background-color: #fe424d; border-color: #fe424d;">Browse Listings</a>
                  </div>
                <% } else { %>
                  <div class="d-flex flex-column gap-3">
                    <% for (let b of upcomingBookings) { %>
                      <div class="border rounded-4 p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                        <div class="d-flex align-items-center gap-3">
                          <img src="<%= (b.listing && b.listing.images && b.listing.images.length > 0) ? b.listing.images[0].url : (b.listing && b.listing.image && b.listing.image.url ? b.listing.image.url : 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=400&q=80') %>" class="rounded-3 shadow-sm" style="width: 80px; height: 65px; object-fit: cover;" alt="">
                          <div>
                            <span class="badge bg-dark font-monospace mb-1"><%= b.bookingRef %></span>
                            <h6 class="mb-0 fw-bold">
                              <% if (b.listing) { %>
                                <a href="/listings/<%= b.listing._id %>" class="text-dark text-decoration-none">
                                  <%= b.listing.title %>
                                </a>
                              <% } else { %>
                                <span class="text-muted">Property Removed</span>
                              <% } %>
                            </h6>
                            <small class="text-muted d-block">
                              <i class="fa-regular fa-calendar me-1"></i>
                              <%= new Date(b.checkIn).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %> &rarr; <%= new Date(b.checkOut).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %>
                            </small>
                            <small class="text-muted">
                              <i class="fa-solid fa-user-group me-1"></i><%= b.totalGuests %> <%= b.totalGuests > 1 ? 'guests' : 'guest' %> &bull; <%= b.totalNights %> <%= b.totalNights > 1 ? 'nights' : 'night' %>
                            </small>
                          </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                          <div class="text-end">
                            <div class="mb-1">
                              <% if (b.status === 'Pending') { %>
                                <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i>Pending Confirmation</span>
                              <% } else if (b.status === 'Confirmed') { %>
                                <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Confirmed</span>
                              <% } %>
                            </div>
                            <span class="fw-bold d-block">&#8377;<%= b.totalPrice.toLocaleString("en-IN") %></span>
                          </div>

                          <form action="/bookings/<%= b._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Are you sure you want to cancel reservation <%= b.bookingRef %>?');">
                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3">Cancel</button>
                          </form>
                        </div>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>

              <!-- Completed Trips -->
              <div class="tab-pane fade" id="completedTrips">
                <% if (completedBookings.length === 0) { %>
                  <div class="text-center py-5">
                    <i class="fa-solid fa-clock-rotate-left text-muted mb-3" style="font-size: 2.75rem;"></i>
                    <h6 class="fw-bold">No completed stays yet</h6>
                    <p class="text-muted small">Your past stays and verified reviews will appear here once you check out.</p>
                  </div>
                <% } else { %>
                  <div class="d-flex flex-column gap-3">
                    <% for (let b of completedBookings) { %>
                      <div class="border rounded-4 p-3 d-flex flex-wrap align-items-center justify-content-between gap-3 bg-light bg-opacity-25">
                        <div class="d-flex align-items-center gap-3">
                          <img src="<%= (b.listing && b.listing.images && b.listing.images.length > 0) ? b.listing.images[0].url : (b.listing && b.listing.image && b.listing.image.url ? b.listing.image.url : 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=400&q=80') %>" class="rounded-3 shadow-sm" style="width: 80px; height: 65px; object-fit: cover;" alt="">
                          <div>
                            <span class="badge bg-secondary font-monospace mb-1"><%= b.bookingRef %></span>
                            <h6 class="mb-0 fw-bold">
                              <% if (b.listing) { %>
                                <a href="/listings/<%= b.listing._id %>" class="text-dark text-decoration-none">
                                  <%= b.listing.title %>
                                </a>
                              <% } else { %>
                                <span class="text-muted">Property Removed</span>
                              <% } %>
                            </h6>
                            <small class="text-muted d-block">
                              Stay completed on <%= new Date(b.checkOut).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %>
                            </small>
                          </div>
                        </div>

                        <div class="d-flex align-items-center gap-3">
                          <div class="text-end">
                            <span class="badge bg-primary mb-1"><i class="fa-solid fa-flag-checkered me-1"></i>Stay Completed</span>
                            <span class="fw-bold d-block text-muted">&#8377;<%= b.totalPrice.toLocaleString("en-IN") %></span>
                          </div>
                          <% if (b.listing) { %>
                            <% if (b.hasReviewed) { %>
                              <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" disabled>
                                <i class="fa-solid fa-check me-1"></i>Reviewed
                              </button>
                            <% } else { %>
                              <a href="/listings/<%= b.listing._id %>#leave-review" class="btn btn-sm btn-danger rounded-pill px-3" style="background-color: #fe424d; border-color: #fe424d;">
                                <i class="fa-regular fa-star me-1"></i>Review Stay
                              </a>
                            <% } %>
                          <% } %>
                        </div>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>

              <!-- Cancelled Trips -->
              <div class="tab-pane fade" id="cancelledTrips">
                <% if (cancelledBookings.length === 0) { %>
                  <div class="text-center py-5">
                    <p class="text-muted small">No cancelled or declined reservations.</p>
                  </div>
                <% } else { %>
                  <div class="d-flex flex-column gap-3">
                    <% for (let b of cancelledBookings) { %>
                      <div class="border rounded-4 p-3 d-flex flex-wrap align-items-center justify-content-between gap-3 text-muted">
                        <div class="d-flex align-items-center gap-3">
                          <img src="<%= (b.listing && b.listing.images && b.listing.images.length > 0) ? b.listing.images[0].url : (b.listing && b.listing.image && b.listing.image.url ? b.listing.image.url : 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=400&q=80') %>" class="rounded-3" style="width: 75px; height: 60px; object-fit: cover; filter: grayscale(80%);" alt="">
                          <div>
                            <span class="badge bg-secondary font-monospace mb-1"><%= b.bookingRef %></span>
                            <h6 class="mb-0 fw-semibold text-secondary">
                              <%= b.listing ? b.listing.title : 'Property Removed' %>
                            </h6>
                            <small class="d-block">
                              <%= new Date(b.checkIn).toLocaleDateString("en-IN", { month: "short", day: "numeric" }) %> - <%= new Date(b.checkOut).toLocaleDateString("en-IN", { month: "short", day: "numeric", year: "numeric" }) %>
                            </small>
                            <% if (b.rejectionReason) { %>
                              <small class="text-danger d-block mt-1"><i class="fa-solid fa-circle-info me-1"></i><%= b.rejectionReason %></small>
                            <% } %>
                          </div>
                        </div>
                        <div>
                          <span class="badge bg-danger bg-opacity-10 text-danger"><%= b.status %></span>
                        </div>
                      </div>
                    <% } %>
                  </div>
                <% } %>
              </div>
            </div>
          </div>

          <!-- 2. Properties Tab -->
          <div class="tab-pane fade" id="properties" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h6 class="fw-bold mb-0">Your Properties (<%= myListings.length %>)</h6>
              <a href="/listings/new" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                <i class="fa-solid fa-plus me-1"></i>Add Property
              </a>
            </div>

            <% if (myListings.length === 0) { %>
              <div class="text-center py-5">
                <i class="fa-solid fa-house-chimney text-muted mb-3" style="font-size: 2.75rem;"></i>
                <h6 class="fw-bold">No properties listed yet</h6>
                <p class="text-muted small">Turn your space into extra income! Create your first property listing now.</p>
                <a href="/listings/new" class="btn btn-dark btn-sm rounded-pill px-4">List Your Home</a>
              </div>
            <% } else { %>
              <div class="d-flex flex-column gap-3">
                <% for (let l of myListings) { %>
                  <div class="border rounded-4 p-3 d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                      <img src="<%= (l.images && l.images.length > 0) ? l.images[0].url : (l.image && l.image.url ? l.image.url : 'https://images.unsplash.com/photo-1568605114967-8130f3a36994?auto=format&fit=crop&w=400&q=80') %>" class="rounded-3 shadow-sm" style="width: 80px; height: 65px; object-fit: cover;" alt="">
                      <div>
                        <div class="mb-1">
                          <% if (l.status === 'pending') { %>
                            <span class="badge bg-warning text-dark"><i class="fa-solid fa-hourglass-half me-1"></i>Pending Review</span>
                          <% } else if (l.status === 'approved' && l.isPublished !== false) { %>
                            <span class="badge bg-success"><i class="fa-solid fa-circle-check me-1"></i>Live on Site</span>
                          <% } else if (l.status === 'rejected') { %>
                            <span class="badge bg-danger" title="<%= l.rejectionReason %>"><i class="fa-solid fa-xmark me-1"></i>Declined</span>
                          <% } else { %>
                            <span class="badge bg-secondary">Unpublished</span>
                          <% } %>
                        </div>
                        <h6 class="mb-0 fw-bold">
                          <a href="/listings/<%= l._id %>" class="text-dark text-decoration-none"><%= l.title %></a>
                        </h6>
                        <small class="text-muted d-block"><%= l.location %>, <%= l.country %></small>
                        <span class="fw-bold small text-dark">&#8377;<%= l.price.toLocaleString("en-IN") %> <span class="text-muted fw-normal">/ night</span></span>
                        <% if (l.status === 'rejected' && l.rejectionReason) { %>
                          <div class="small text-danger mt-1">
                            <i class="fa-solid fa-circle-exclamation me-1"></i>Declined reason: <%= l.rejectionReason %>
                          </div>
                        <% } %>
                      </div>
                    </div>

                    <div class="d-flex gap-2">
                      <a href="/listings/<%= l._id %>/edit" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                        <i class="fa-solid fa-pen-to-square me-1"></i>Edit
                      </a>
                      <a href="/listings/<%= l._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                        <i class="fa-solid fa-eye me-1"></i>View
                      </a>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>

          <!-- 3. Wishlist Tab -->
          <div class="tab-pane fade" id="wishlist" role="tabpanel">
            <div class="d-flex justify-content-between align-items-center mb-3">
              <h5 class="fw-bold mb-0">Saved Properties</h5>
              <span id="headerWishlistBadge" class="badge bg-light text-secondary border">
                <%= savedListings ? savedListings.length : 0 %> <%= (savedListings && savedListings.length === 1) ? 'Stay' : 'Stays' %> Saved
              </span>
            </div>

            <% if (!savedListings || savedListings.length === 0) { %>
              <div class="text-center py-5 bg-light rounded-4 border">
                <div class="mb-3">
                  <i class="fa-regular fa-heart display-4 text-muted"></i>
                </div>
                <h5 class="fw-bold text-dark mb-1">Your wishlist is empty</h5>
                <p class="text-muted small mb-3">Explore amazing places to stay and click the heart icon on any listing to save your favorites here.</p>
                <a href="/listings" class="btn btn-danger rounded-pill px-4 py-2 fw-semibold" style="background-color: #fe424d; border-color: #fe424d;">
                  <i class="fa-solid fa-compass me-1"></i>Explore Stays
                </a>
              </div>
            <% } else { %>
              <div class="row g-3" id="wishlistItemsContainer">
                <% for (let item of savedListings) { 
                    const itemImg = (item.image && item.image.url) ? item.image.url : (item.images && item.images.length > 0 && item.images[0].url ? item.images[0].url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?auto=format&fit=crop&w=800&q=60');
                    let itemAvgRating = "New";
                    if (item.reviews && item.reviews.length > 0) {
                      const sumR = item.reviews.reduce((acc, r) => acc + (r.rating || 0), 0);
                      itemAvgRating = (sumR / item.reviews.length).toFixed(1);
                    }
                %>
                  <div class="col-12 col-md-6" id="wishlist-card-<%= item._id %>">
                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative">
                      <!-- Property Image -->
                      <div class="position-relative" style="height: 180px;">
                        <img src="<%= itemImg %>" class="w-100 h-100" alt="<%= item.title %>" style="object-fit: cover;">
                        <!-- Rating badge overlay -->
                        <span class="badge bg-white text-dark position-absolute top-0 start-0 m-2 shadow-sm rounded-pill px-2 py-1 fw-bold" style="font-size: 0.75rem;">
                          <i class="fa-solid fa-star text-warning me-1"></i><%= itemAvgRating %>
                        </span>
                        <!-- Remove from Wishlist action button overlay -->
                        <form action="/listings/<%= item._id %>/wishlist?_method=DELETE" method="POST" class="position-absolute top-0 end-0 m-2 remove-wishlist-form" data-id="<%= item._id %>">
                          <button type="submit" class="btn btn-light btn-sm rounded-circle shadow p-0 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;" title="Remove from wishlist">
                            <i class="fa-solid fa-heart text-danger"></i>
                          </button>
                        </form>
                      </div>

                      <!-- Card Body -->
                      <div class="card-body p-3 d-flex flex-column justify-content-between">
                        <div>
                          <h6 class="fw-bold mb-1 text-truncate" title="<%= item.title %>"><%= item.title %></h6>
                          <p class="text-muted small mb-2 text-truncate">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i><%= item.location %>, <%= item.country %>
                          </p>
                        </div>

                        <div class="d-flex align-items-center justify-content-between pt-2 border-top mt-2">
                          <div>
                            <span class="fw-bold text-dark">&#8377;<%= item.price ? item.price.toLocaleString("en-IN") : 0 %></span>
                            <span class="text-muted small"> / night</span>
                          </div>
                          <div>
                            <a href="/listings/<%= item._id %>" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                              <i class="fa-solid fa-eye me-1"></i>View Stay
                            </a>
                          </div>
                        </div>
                      </div>
                    </div>
                  </div>
                <% } %>
              </div>
            <% } %>
          </div>

          <!-- 4. Profile & Security Settings Tab -->
          <div class="tab-pane fade" id="settings" role="tabpanel">
            <!-- Edit Profile Form -->
            <div class="mb-4">
              <h6 class="fw-bold mb-3 border-bottom pb-2">Edit Personal Information</h6>
              <form action="/profile?_method=PUT" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
                <div class="row g-3">
                  <div class="col-12 col-md-6">
                    <label for="fullName" class="form-label fw-semibold">Full Name</label>
                    <input type="text" class="form-control rounded-3" id="fullName" name="fullName" value="<%= user.fullName || '' %>" required>
                  </div>
                  <div class="col-12 col-md-6">
                    <label for="username" class="form-label fw-semibold text-muted">Username (Read-only)</label>
                    <input type="text" class="form-control rounded-3 bg-light" id="username" value="<%= user.username %>" readonly>
                  </div>
                  <div class="col-12 col-md-6">
                    <label for="email" class="form-label fw-semibold">Email Address</label>
                    <input type="email" class="form-control rounded-3" id="email" name="email" value="<%= user.email %>" required>
                  </div>
                  <div class="col-12 col-md-6">
                    <label for="mobile" class="form-label fw-semibold">Mobile Number</label>
                    <input type="tel" class="form-control rounded-3" id="mobile" name="mobile" value="<%= user.mobile || '' %>" placeholder="+91 98765 43210" required>
                  </div>
                  <div class="col-12">
                    <label for="profileImage" class="form-label fw-semibold">Update Profile Picture</label>
                    <input type="file" class="form-control rounded-3" id="profileImage" name="profileImage" accept="image/*">
                    <div class="form-text text-muted">Accepts JPG, PNG, WEBP up to 5 MB.</div>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="btn btn-dark rounded-3 px-4">Save Changes</button>
                  </div>
                </div>
              </form>
            </div>

            <!-- Change Password Form -->
            <div class="mt-4 pt-3 border-top">
              <h6 class="fw-bold mb-3 border-bottom pb-2">Change Password</h6>
              <form action="/profile/change-password" method="POST" class="needs-validation" novalidate>
                <div class="row g-3">
                  <div class="col-12 col-md-4">
                    <label for="currentPassword" class="form-label fw-semibold">Current Password</label>
                    <input type="password" class="form-control rounded-3" id="currentPassword" name="currentPassword" required>
                  </div>
                  <div class="col-12 col-md-4">
                    <label for="newPassword" class="form-label fw-semibold">New Password</label>
                    <input type="password" class="form-control rounded-3" id="newPassword" name="newPassword" minlength="8" placeholder="Min 8 characters" required>
                  </div>
                  <div class="col-12 col-md-4">
                    <label for="confirmNewPassword" class="form-label fw-semibold">Confirm New Password</label>
                    <input type="password" class="form-control rounded-3" id="confirmNewPassword" name="confirmNewPassword" minlength="8" required>
                  </div>
                  <div class="col-12">
                    <button type="submit" class="btn btn-outline-danger rounded-3 px-4">Update Password</button>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // Tab activation from URL hash (e.g. #wishlist or #properties)
  document.addEventListener("DOMContentLoaded", () => {
    const hash = window.location.hash;
    if (hash) {
      const targetTabBtn = document.querySelector(`button[data-bs-target="${hash}"]`);
      if (targetTabBtn) {
        const tabTrigger = new bootstrap.Tab(targetTabBtn);
        tabTrigger.show();
      }
    }

    // AJAX removal from Wishlist in profile
    document.querySelectorAll(".remove-wishlist-form").forEach((form) => {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        const id = form.getAttribute("data-id");
        const card = document.getElementById(`wishlist-card-${id}`);
        try {
          const res = await fetch(`/listings/${id}/wishlist`, {
            method: "DELETE",
            headers: {
              "Accept": "application/json",
              "Content-Type": "application/json",
            },
          });
          const data = await res.json();
          if (data && data.success) {
            if (card) {
              card.remove();
            }
            const remaining = document.querySelectorAll("#wishlistItemsContainer > div").length;
            const sidebarCount = document.getElementById("sidebarWishlistCount");
            if (sidebarCount) sidebarCount.textContent = remaining;
            const tabCount = document.getElementById("tabWishlistCount");
            if (tabCount) tabCount.textContent = remaining;
            const headerBadge = document.getElementById("headerWishlistBadge");
            if (headerBadge) headerBadge.textContent = `${remaining} ${remaining === 1 ? 'Stay' : 'Stays'} Saved`;

            if (remaining === 0) {
              window.location.hash = "#wishlist";
              location.reload();
            }
          } else {
            form.submit();
          }
        } catch (err) {
          form.submit();
        }
      });
    });
  });
</script>
