<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
    <div class="col-12 col-md-8 offset-md-2">
        <div class="alert alert-danger shadow-sm rounded-4 p-4" role="alert">
            <h4 class="alert-heading fw-bold">
                <i class="fa-solid fa-triangle-exclamation me-2"></i>Error
            </h4>
            <p class="mb-3 fs-5"><%= (err && err.message) ? err.message : (typeof message !== 'undefined' ? message : 'Something went wrong!') %></p>
            <hr>
            <div class="d-flex justify-content-between align-items-center">
                <span class="text-muted small">Status Code: <%= typeof statusCode !== 'undefined' ? statusCode : (err && err.statusCode ? err.statusCode : 500) %></span>
                <a href="/listings" class="btn btn-outline-danger btn-sm">Return to Home</a>
            </div>
        </div>
    </div>
</div>